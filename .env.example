# --- HTTP mode (npm run start:http) ---
# Required. Generate with: openssl rand -hex 32
TRAVEL_MCP_TOKEN=
HOST=127.0.0.1
PORT=3000
RATE_LIMIT_PER_MINUTE=60

# --- Upstream APIs ---
# Nominatim requires an identifying User-Agent. Put your own contact/repo URL here.
TRAVEL_MCP_USER_AGENT=travel-mcp/0.1.0 (https://github.com/zelaplagg/travel-mcp)
